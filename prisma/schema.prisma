generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobType {
  GET_CUSTOMER
  GET_OPPORTUNITY
  CREATE_OPPORTUNITY
  CREATE_STOCK_ITEM
  UPDATE_OPPORTUNITY
  ERP_GET_ORDER_HEADER
  ERP_GET_PAYMENT_INFO
  ERP_GET_INVENTORY_DETAILS
  ERP_GET_ORDER_SUMMARIES
  ERP_GET_ORDER_SUMMARIES_DELTA
  ERP_GET_ADDRESS_CONTACT
  ERP_GET_ORDER_LAST_MODIFIED
  ERP_GET_ORDER_READY_REPORT
  ERP_GET_CLOSEOUT_INVENTORY_REPORT
  ERP_GET_THANK_YOU_REPORT
  ERP_FIND_DELIVERY_SALES_ORDERS_BY_LINE_REQUESTED_ON
  ERP_GET_DELIVERY_SALES_ORDER_FULL
  ERP_COUNT_OPEN_SALES_ORDERS_WITH_CONTACT
  ERP_GET_DELIVERY_CONTACT
  ERP_UPDATE_DELIVERY_CONFIRMATION_ATTRIBUTES
  ERP_UPDATE_DELIVERY_REQUESTED_DATE
  ERP_UPDATE_DELIVERY_CONTACT_OPT_IN_ATTRIBUTES
  ERP_UPDATE_DELIVERY_PREPAYMENT_HOLD
  ERP_UPDATE_DELIVERY_TEN_DAY_CONFIRMATION
  ERP_MARK_THANK_YOU_SENT
  ERP_VERIFY_CUSTOMER
  ERP_PUT_SALES_INVOICE
  ERP_PUT_CUSTOMER_LOCATION
  ERP_STOCK_ITEM_CLEANUP_RUN
  GET_CONTACT
  GET_STOCK_ITEM
  GET_ITEM_CLASS
}

enum JobStatus {
  queued
  processing
  succeeded
  failed
}

enum StockItemCleanupRunStatus {
  queued
  processing
  completed
  failed
}

enum StockItemCleanupItemStatus {
  pending
  processing
  dry_run_ready
  updated_successfully
  already_updated
  skipped_qty_on_hand
  skipped_item_class
  skipped_vendor_review
  failed_api_transient
  failed_validation_business_rule
  refused_write
}

model Job {
  id              String           @id
  vendorId        String
  type            JobType
  status          JobStatus        @default(queued)
  entityKey       String?
  payload         Json?
  result          Json?
  error           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  idempotencyKeys IdempotencyKey[]

  @@index([vendorId, createdAt])
  @@index([status, createdAt])
  @@map("jobs")
}

model IdempotencyKey {
  vendorId  String
  key       String
  jobId     String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([vendorId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model RateLimitWindow {
  id          String   @id @default(cuid())
  vendorId    String
  routeKey    String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendorId, routeKey, windowStart])
  @@index([windowStart])
  @@map("rate_limit_windows")
}

model OpportunityUpdateBuffer {
  opportunityId String   @id
  latestPayload Json
  pending       Boolean  @default(true)
  lastJobId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pending, updatedAt])
  @@map("opportunity_update_buffer")
}

model StockItemCleanupRun {
  id             String                    @id
  jobId          String?                   @unique
  status         StockItemCleanupRunStatus @default(queued)
  dryRun         Boolean                   @default(true)
  writeMode      Boolean                   @default(false)
  maxItems       Int                       @default(10)
  maxInFlight    Int                       @default(1)
  delayMs        Int                       @default(0)
  requestedCount Int                       @default(0)
  currentItemId  String?
  lastItemId     String?
  error          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  items          StockItemCleanupItem[]

  @@index([status, createdAt])
  @@map("stock_item_cleanup_runs")
}

model StockItemCleanupItem {
  id                 String                     @id @default(cuid())
  runId              String
  inventoryId        String
  description        String?
  currentItemClass   String?
  proposedVendorId   String?
  proposedVendorName String?
  vendorConfidence   String?
  vendorMatchReason  String?
  sourcePayload      Json?
  status             StockItemCleanupItemStatus @default(pending)
  attemptCount       Int                        @default(0)
  oldVendorId        String?
  oldVendorName      String?
  newVendorId        String?
  newVendorName      String?
  vendorClass        String?
  oldItemClass       String?
  newItemClass       String?
  qtyOnHandSummary   Json?
  beforeState        Json?
  afterState         Json?
  acumaticaResponse  Json?
  verification       Json?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  run StockItemCleanupRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, inventoryId])
  @@index([runId, status, createdAt])
  @@index([inventoryId])
  @@map("stock_item_cleanup_items")
}
