{
  "name": "specbooks-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../prisma/schema.prisma",
    "validate:delivery-prepayment-hold": "tsx scripts/validate-delivery-prepayment-hold.ts",
    "validate:delivery-contact-opt-in-fetch": "tsx scripts/validate-delivery-contact-opt-in-fetch.ts",
    "validate:one-week-confirmation-writeback": "tsx scripts/validate-delivery-ten-day-confirmation.ts"
  },
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "@prisma/client": "^6.6.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
